# SetQuant environment variables
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.

# ─────────────────────────────────────────────────────────────
# Required to run the app (frontend + Go API + Postgres)
# ─────────────────────────────────────────────────────────────

# Local Postgres credentials (used by docker-compose to init the db service)
POSTGRES_USER=setquant_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=setquant_db

# Connection string read by the Go backend and the Python scraper.
# Local (docker-compose):  postgresql://setquant_user:change_me@db:5432/setquant_db
# Production: your Neon connection string (with ?sslmode=require)
DATABASE_URL=postgresql://setquant_user:change_me@localhost:5432/setquant_db

# Go backend
PORT=8080
APP_ENV=dev          # set to "prod" in production

# Frontend API base URL lives in frontend/.env.local (see frontend/.env.local.example),
# NOT here — it must be NEXT_PUBLIC_ prefixed and is inlined at build time.

# ─────────────────────────────────────────────────────────────
# Optional — Twitter bot feature only. NOT needed to run/deploy the app.
# Leave unset unless you are running the daily tweet pipeline locally.
# ─────────────────────────────────────────────────────────────
# WEBHOOK_SECRET=
# WEBHOOK_URL=http://localhost:8080/api/internal/trigger-daily-tweet
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=
